# RSS Feed Generator - Environment Configuration
#
# Copy this file to .env and customize for your deployment

# Base URL where feeds will be served (used in feed self-links)
# For local development:
FEED_BASE_URL=http://localhost:8080/feeds
# For production with your own domain:
# FEED_BASE_URL=https://rss.yourdomain.com/feeds

# Cron schedule for feed updates (default: hourly)
# Format: minute hour day month weekday
CRON_SCHEDULE=0 * * * *
# For every 30 minutes:
# CRON_SCHEDULE=*/30 * * * *
# For every 6 hours:
# CRON_SCHEDULE=0 */6 * * *
